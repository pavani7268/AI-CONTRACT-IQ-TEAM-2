APP_NAME=AI Contract IQ
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev (no PostgreSQL needed)
DATABASE_URL=sqlite+aiosqlite:///./ai_contract_iq.db
DATABASE_URL_SYNC=sqlite:///./ai_contract_iq.db

JWT_SECRET_KEY=ai-contract-iq-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt

