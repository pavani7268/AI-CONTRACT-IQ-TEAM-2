# ---- Database ----
# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_contract_iq

# Sync connection string used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_contract_iq

# ---- JWT Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- File storage ----
STORAGE_DIR=./storage
CONTRACTS_SUBDIR=contracts
REPORTS_SUBDIR=reports
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx

# ---- App ----
APP_NAME=AI Contract IQ
ENVIRONMENT=development
DEBUG=true
